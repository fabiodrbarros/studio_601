# Add only after confirming the existing server uses Nginx on the host.
# Obtain the certificate using the existing certificate-management process.
server {
    listen 80;
    server_name studio601.fabiodrbarros.cloud;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name studio601.fabiodrbarros.cloud;
    ssl_certificate /etc/ssl/studio601/fullchain.pem;
    ssl_certificate_key /etc/ssl/studio601/privkey.pem;
    client_max_body_size 11m;

    location / {
        proxy_pass http://127.0.0.1:30601;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 60s;
    }
}
