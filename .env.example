# Docker Compose: copiar para .env (não versionar).
# Origem pública exata, sem barra final. Obrigatória para login e cookies Secure.
APP_ORIGIN=https://studio601.fabiodrbarros.cloud
# Porta publicada apenas no loopback da VPS; confirmar disponibilidade antes de usar.
PORT=30601
BIND_ADDRESS=127.0.0.1
IMAGE_TAG=local
# Compose fixa SQLite em /data/studio601.sqlite e uploads em /data/uploads.
# Não são necessários tokens Cloudflare, SMTP, OAuth ou um segredo de sessão.
# Criar conta: docker compose exec website node scripts/admin-account.mjs create
# A password é pedida sem eco no terminal; não a guardar aqui.
# Desenvolvimento sem Docker: .env.local com APP_ORIGIN=http://127.0.0.1:3000
# STUDIO_DB_PATH=./data/studio601.sqlite (apenas execução local, não Compose).
